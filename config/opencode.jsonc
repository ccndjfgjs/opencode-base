{
  "$schema": "https://opencode.ai/config.json",
  // Локальная база памяти пользователя — автоматически загружается
  // в КАЖДУЮ сессию (все модели, CLI и десктоп), без ручных действий.
  //
  // Пометка {{BASE}} — это место, куда программа подставляет настоящий
  // путь базы при подключении. Так файл годится для любого компьютера.
  "instructions": [
    "{{BASE}}/profile.md",
    "{{BASE}}/projects.md",
    "{{BASE}}/facts.md",
    "{{BASE}}/библиотека/АКТИВНАЯ-ПАМЯТЬ.md",
    "{{BASE}}/КАРТА-БАЗЫ.md",
    "{{BASE}}/ПРАВИЛА-ИИ.md"
  ]
}
