# Python
__pycache__/
*.py[cod]

# Отчёт самопроверки содержит реальные пути машины — не публикуется
selftest-report.txt

# Ярлыки
*.lnk

# Node
node_modules/

# Служебное
Thumbs.db
Desktop.ini

# Отладочные скрипты, которые снимают после проверки правки
_trash-*/

# Отметка «окно первого запуска уже показывали» — состояние этой машины
.first-run-done

# Модель голоса качается скриптом tools\voice\fetch_model.py — 73 МБ
tools/voice/models/

# Скриншоты, которые мост pc-bridge делает для проверки ввода с клавиатуры
tools/pc-bridge/shots/

# Живой список прокси — обновляется кнопкой в окне, отдельно от эталона
tools/antiblock/public_socks5.local.txt

# Личные данные пользователя — не публикуются
profile.md
facts.md
projects.md
созданные-базы.json
debug.log
themes/
sessions/
projects/
личное/
журнал-решений/
память/
библиотека/записи/личное/*
# Папку возвращаем, содержимое снова исключаем, и только потом
# возвращаем один служебный файл. Именно в таком порядке: git не умеет
# re-include файла, если исключена его папка, а папку личное исключают
# сразу два правила — `личное/` выше и `библиотека/записи/личное/*` здесь.
!библиотека/записи/личное/
библиотека/записи/личное/*
# `_О-ПАПКЕ.md` объясняет, что папка личная и из неё ничего не уезжает.
# Он должен быть в программе: иначе база, созданная на другом
# компьютере, получит в папке личное заглушку «см. КАРТА-БАЗЫ.md» вместо
# этого объяснения, и проверка это ловит. Личные записи
# (`личное/<тема>/*.md`) под правилом остаются и в репозиторий не идут.
!библиотека/записи/личное/_О-ПАПКЕ.md
библиотека/журнал/
библиотека/АКТИВНАЯ-ПАМЯТЬ.md
библиотека/КАТАЛОГ.md
библиотека/index.json

# Личное и секретное: отпечаток железа, пароль прокси,
# конфигурация VPN, кэш и база. Репозиторий публичный,
# а внутри отсюда на весь мир: идентификатор железа и пароль
# оттуда уже не возвратить.
config/.secrets/
config/cache/
config/data/
config/device_id
config/hwid
config/preferences.json
config/*.db
config/*.log
