#!/bin/sh
# Pre-commit: план не должен потерять содержимое, а папка программы —
# не разойтись с конструктором.
#
# Зачем первый. Структурная проверка видит, что блоки и шаги на месте, но не
# видит их содержимое: потерянные две строки из блока «Файлы» задачи 4а прошли
# мимо счёта шагов и счёта блоков, поймал только diff.
#
# Зачем второй. Программа живёт в двух экземплярах, и перенос правок между
# ними делался руками. Правка, чинившая семь областей знаний, несколько дней
# жила в одном экземпляре, а четыре проверки потерялись молча при
# восстановлении файла.
#
# Про код 3. Сверка различает три состояния: расхождение (блокируем),
# совпадение (молчим) и «не настроена» (предупреждаем, но не блокируем).
# Третье — на чистом клоне для CI, где папки программы нет, и там коммит
# обязан проходить.
#
# Почему `set -e` стоит, а коды всё равно проверяются. `set -e` глушит
# команду, вернувшую ненулевой код, — и скрипт упал бы раньше, чем мы
# посмотрели на `$?`. Поэтому проверки идут внутри `if` и `case`: там
# `set -e` не срабатывает, и код виден.
#
# Обход: git commit --no-verify. Это страховка от забывчивости, а не
# намеренный обход.
set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
ROOT="$(cd "$HERE/../.." && pwd)"
PY="${PYTHON:-python}"

echo "pre-commit: сверяю план с последним закоммиченным..."
if ! "$PY" "$ROOT/tools/проверки/plan_diff_git.py"; then
    echo ""
    echo "pre-commit: СВЕРКА НЕ ПРОШЛА. Разберись и повтори."
    echo "  Если падения нет по-настоящему и это ложная тревога — запусти"
    echo "  скрипт вручную и посмотри вывод, прежде чем обходить."
    exit 1
fi

echo "pre-commit: сверяю папку программы с конструктором..."
SYNC=0
"$PY" "$ROOT/tools/проверки/сверь-копии.py" || SYNC=$?

case "$SYNC" in
    0)
        ;;
    1)
        echo ""
        echo "pre-commit: папка программы и конструктор разошлись."
        echo "  Список расхождений — выше. Правка, которая не попала в git,"
        echo "  выглядит как работающая программа, и через месяц об этом"
        echo "  узнают случайно. Скопируй правку в конструктор."
        exit 1
        ;;
    3)
        echo "pre-commit: ВНИМАНИЕ — сверка не выполнена, а не пройдена."
        echo "  Коммит пропущен, но совпадение копий никто не проверял."
        echo "  Укажи путь: переменная OPENCODE_PROGRAM_ROOT или файл"
        echo "  .git/путь-к-папке-программы в корне репозитория."
        ;;
    *)
        echo "pre-commit: сверка упала с кодом $SYNC. Разбираться надо."
        exit 1
        ;;
esac

exit 0