#!/bin/sh
# Pre-commit: план не должен потерять содержимое.
#
# Зачем. Структурная проверка видит, что блоки и шаги на месте, но не видит
# их содержимое: потерянные две строки из блока «Файлы» задачи 4а прошли
# мимо счёта шагов и счёта блоков, поймал только diff. Если diff останется
# делом рук, он рано или поздно забудется.
#
# Хук не пропускает коммит при пропавших строках: их надо разобрать и
# подтвердить явно.
#
# Обход: git commit --no-verify. Как и у pre-push, это страховка от
# забывчивости, а не намеренный обход.
set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
ROOT="$(cd "$HERE/../.." && pwd)"
PY="${PYTHON:-python}"

echo "pre-commit: сверяю план с последним закоммиченным..."
if ! "$PY" "$ROOT/tools/проверки/plan_diff_git.py"; then
    echo ""
    echo "pre-commit: СВЕРКА НЕ ПРОШЛА. Разберись и повтори."
    echo "  Если падения нет по-настоящему и это ложная тревога — запусти"
    echo "  скрипт вручную и посмотри вывод, прежде чем обходить."
    exit 1
fi
echo "pre-commit: ÑÐ²ÐµÑÑÑ Ð¿Ð°Ð¿ÐºÑ Ð¿ÑÐ¾Ð³ÑÐ°Ð¼Ð¼Ñ Ñ ÐºÐ¾Ð½ÑÑÑÑÐºÑÐ¾ÑÐ¾Ð¼..."
"$PY" "$ROOT/tools/проверки/сверь-копии.py"
SYNC=$?
if [ $SYNC -eq 1 ]; then
    echo ""
    echo "pre-commit: Ð¿Ð°Ð¿ÐºÐ° Ð¿ÑÐ¾Ð³ÑÐ°Ð¼Ð¼Ñ Ð¸ ÐºÐ¾Ð½ÑÑÑÑÐºÑÐ¾Ñ ÑÐ°Ð·Ð¾ÑÐ»Ð¸ÑÑ."
    echo "  Ð¡Ð¿Ð¸ÑÐ¾Ðº ÑÐ°ÑÑÐ¾Ð¶Ð´ÐµÐ½Ð¸Ð¹ â Ð²ÑÑÐµ. ÐÑÐ°Ð²ÐºÐ°, ÐºÐ¾ÑÐ¾ÑÐ°Ñ Ð½Ðµ Ð¿Ð¾Ð¿Ð°Ð»Ð° Ð² git,"
    echo "  Ð²ÑÐ³Ð»ÑÐ´Ð¸Ñ ÐºÐ°Ðº ÑÐ°Ð±Ð¾ÑÐ°ÑÑÐ°Ñ Ð¿ÑÐ¾Ð³ÑÐ°Ð¼Ð¼Ð°, Ð¸ ÑÐµÑÐµÐ· Ð¼ÐµÑÑÑ Ð¾Ð± ÑÑÐ¾Ð¼"
    echo "  ÑÐ·Ð½Ð°ÑÑ ÑÐ»ÑÑÐ°Ð¹Ð½Ð¾. Ð¡ÐºÐ¾Ð¿Ð¸ÑÑÐ¹ Ð¿ÑÐ°Ð²ÐºÑ Ð² ÐºÐ¾Ð½ÑÑÑÑÐºÑÐ¾Ñ."
    exit 1
elif [ $SYNC -eq 3 ]; then
    echo "pre-commit: ÐÐÐÐÐÐÐÐ â ÑÐ²ÐµÑÐºÐ° Ð½Ðµ Ð²ÑÐ¿Ð¾Ð»Ð½ÐµÐ½Ð°, Ð° Ð½Ðµ Ð¿ÑÐ¾Ð¹Ð´ÐµÐ½Ð°."
    echo "  ÐÐ¾Ð¼Ð¼Ð¸Ñ Ð¿ÑÐ¾Ð¿ÑÑÐµÐ½, Ð½Ð¾ ÑÐ¾Ð²Ð¿Ð°Ð´ÐµÐ½Ð¸Ðµ ÐºÐ¾Ð¿Ð¸Ð¹ Ð½Ð¸ÐºÑÐ¾ Ð½Ðµ Ð¿ÑÐ¾Ð²ÐµÑÑÐ»."
elif [ $SYNC -ne 0 ]; then
    echo "pre-commit: ÑÐ²ÐµÑÐºÐ° ÑÐ¿Ð°Ð»Ð° Ñ ÐºÐ¾Ð´Ð¾Ð¼ $SYNC. Ð Ð°Ð·Ð±Ð¸ÑÐ°ÑÑÑÑ Ð½Ð°Ð´Ð¾."
