#!/bin/sh
# Pre-push: отправка возможна только по одноразовому разрешению.
#
# Почему не переменная окружения. Первая версия хука требовала
# ALLOW_PUSH=1. Отправки всё равно прошли: ALLOW_PUSH не была выставлена
# ни в сессии, ни в переменных Windows, core.hooksPath не подменён, а
# --dry-run при проверке показал, что он ничего не отправляет и метку
# origin/ не двигает. Команду, которой ушёл коммит, установить не удалось.
#
# Переменная окружения к тому же живёт дольше намерения: она остаётся
# выставленной, пока о ней не подумают. Разрешение-файл решает это иначе —
# его создаёт человек, и хук удаляет при первой же попытке.
#
# Как пользоваться:
#
#     git rev-parse HEAD > .git/разрешение-отправки
#     git push origin main
#
# Что делает хук:
#   1) разрешения нет — отказ;
#   2) в разрешении не тот коммит — отказ (разрешение на один коммит не
#      годится для другого);
#   3) всё сошлось — печатает, что уходит, и УДАЛЯЕТ разрешение.
#
# Из-за удаления разрешение одноразовое: вторая попытка откажется, пока
# файл не создадут заново. Отказ при неудачной отправке — намеренно:
# безопаснее лишнее разрешение, чем отправка без спроса.
#
# Обход: git push --no-verify хук пропускает. Это страховка от
# забывчивости, а не от намеренного обхода.
#
# Хуки не хранятся в git. Установка:
#     cp tools/проверки/pre-push .git/hooks/pre-push
#     chmod +x .git/hooks/pre-push

set -e

REMOTE_NAME=$(echo "$1" | tr -d "'")
URL=$(echo "$2" | tr -d "'")
GIT_DIR_PATH=$(git rev-parse --git-dir)
PERMIT="${GIT_DIR_PATH}/разрешение-отправки"
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo '')
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)

refuse() {
    echo "ОТКАЗ: $1" >&2
    echo "" >&2
    echo "  удалённый:  ${REMOTE_NAME}  ${URL}" >&2
    echo "  ветка:      ${BRANCH}" >&2
    echo "  коммит:     ${HEAD_SHA}" >&2
    echo "  что уходит:" >&2
    if [ -n "$UPSTREAM" ]; then
        git log --oneline "${UPSTREAM}..HEAD" 2>/dev/null | sed 's/^/    /' >&2
        git diff --stat "${UPSTREAM}..HEAD" 2>/dev/null | sed 's/^/    /' >&2
    else
        echo "    (ветка не отслеживает удалённую: отправка создаст её)" >&2
        git log --oneline -5 2>/dev/null | sed 's/^/    /' >&2
    fi
    echo "" >&2
    echo "  Если решение о проверке авторов и поиска по изменениям принято:" >&2
    echo "      git rev-parse HEAD > '${GIT_DIR_PATH}/разрешение-отправки'" >&2
    echo "      git push ${REMOTE_NAME} ${BRANCH}" >&2
    echo "" >&2
    echo "  Проверить без отправки:" >&2
    echo "      git rev-parse HEAD > '${GIT_DIR_PATH}/разрешение-отправки'" >&2
    echo "      git push --dry-run ${REMOTE_NAME} ${BRANCH}" >&2
    echo "      (--dry-run не отправляет, но разрешение расходует)" >&2
    exit 1
}

if [ ! -f "$PERMIT" ]; then
    refuse "нет файла разрешения. Создать: git rev-parse HEAD > '${GIT_DIR_PATH}/разрешение-отправки'"
fi

PERMIT_SHA=$(head -n 1 "$PERMIT" 2>/dev/null | tr -d ' \r\n')

if [ -z "$PERMIT_SHA" ]; then
    refuse "файл разрешения пуст: '${PERMIT}'"
fi

if [ "$PERMIT_SHA" != "$HEAD_SHA" ]; then
    refuse "разрешение выдано на другой коммит: в файле ${PERMIT_SHA}, а отправляется ${HEAD_SHA}"
fi

# Разрешение одноразовое: расходуется здесь, до отправки.
rm -f "$PERMIT"

exit 0